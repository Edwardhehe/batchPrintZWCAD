<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.15.5</Version>
    <AssemblyVersion>1.15.5.0</AssemblyVersion>
    <FileVersion>1.15.5.0</FileVersion>
    <InformationalVersion>1.15.5</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefineConstants>$(DefineConstants);ZWCAD</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="FileTools\**\*.cs" />
    <Compile Remove="src\AutoCAD\**\*.cs" />
    <Compile Remove="src\PianNoCN\**\*.cs" />
    <Compile Remove="lib\**\*.cs" />
    <Compile Remove="local-artifacts\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="tmp\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="obj*\**\*.cs" />
    <Compile Remove="_tmp*\**\*.cs" />
    <Compile Remove="._tmp*\**\*.cs" />
    <EmbeddedResource Remove="FileTools\**\*" />
    <EmbeddedResource Remove="src\AutoCAD\**\*" />
    <EmbeddedResource Remove="local-artifacts\**\*" />
    <EmbeddedResource Remove="tests\**\*" />
    <EmbeddedResource Remove="tmp\**\*" />
    <EmbeddedResource Remove="obj\**\*" />
    <EmbeddedResource Remove="obj*\**\*" />
    <EmbeddedResource Remove="_tmp*\**\*" />
    <EmbeddedResource Remove="._tmp*\**\*" />
    <None Remove="FileTools\**\*" />
    <None Remove="src\AutoCAD\**\*" />
    <None Remove="local-artifacts\**\*" />
    <None Remove="tests\**\*" />
    <None Remove="tmp\**\*" />
    <None Remove="obj\**\*" />
    <None Remove="obj*\**\*" />
    <None Remove="_tmp*\**\*" />
    <None Remove="._tmp*\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ZwManaged">
      <HintPath>C:\Program Files\ZWSOFT\ZWCAD Enterprise\ZwManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZwDatabaseMgd">
      <HintPath>C:\Program Files\ZWSOFT\ZWCAD Enterprise\ZwDatabaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src\PianNoCN\PianNoCN.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="1.50.5147" />
    <PackageReference Include="SharpZipLib" Version="1.3.3" />
    <PackageReference Include="System.Resources.Extensions" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="resources\zwcad\Plotters\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Plotters\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
</Project>
