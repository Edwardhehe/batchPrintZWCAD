<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZwcadBatchPlot.CustomScaleForm"
        Title="自定义打印比例"
        Width="420" Height="180"
        MinWidth="360" MinHeight="170"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 对应原 TableLayoutPanel（单列 7/6 行）；有图幅候选时首行下方多一行目标图幅下拉。 -->
    <Grid x:Name="_panel" Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition x:Name="_paperChoiceRow" Height="30" />
            <RowDefinition Height="26" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- 图纸尺寸信息 -->
        <TextBlock x:Name="_info" Grid.Row="0" VerticalAlignment="Center" Foreground="DimGray" TextTrimming="None" />

        <!-- 目标图幅下拉行（仅 allowAspectRatioPapers 且检测到候选时可见） -->
        <StackPanel x:Name="_paperChoicePanel" Grid.Row="1" Orientation="Horizontal" Visibility="Collapsed">
            <TextBlock Text="目标图幅  " VerticalAlignment="Center" />
            <ComboBox x:Name="_paperCombo" Width="300" IsEditable="False"
                      VerticalContentAlignment="Center" SelectionChanged="PaperCombo_SelectionChanged" />
        </StackPanel>

        <!-- 比例输入行："1 : " 前缀 + 数字输入框 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock x:Name="_scalePrefixLabel" Text="打印比例  1 : " VerticalAlignment="Center" />
            <TextBox x:Name="_scaleInput" Width="160" VerticalContentAlignment="Center"
                     TextChanged="ScaleInput_TextChanged" />
        </StackPanel>

        <!-- 换算后的纸张尺寸 / 校验提示 -->
        <TextBlock x:Name="_paperSizeLabel" Grid.Row="3" VerticalAlignment="Center" Foreground="#0078D4" />

        <!-- 附加说明 -->
        <TextBlock x:Name="_hint" Grid.Row="4" VerticalAlignment="Top" Foreground="DimGray"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="6">
            <!-- WinForms FlowDirection=RightToLeft，先加的在最右。 -->
            <DockPanel LastChildFill="False" Margin="0,6,0,0">
                <Button Content="确定" MinWidth="76" DockPanel.Dock="Right"
                        IsDefault="True" Style="{StaticResource PluginButtonStyle}" Click="Ok_Click" />
                <Button Content="取消" MinWidth="76" DockPanel.Dock="Right"
                        IsCancel="True" Style="{StaticResource PluginButtonStyle}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
