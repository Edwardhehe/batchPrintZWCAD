<Window x:Class="ZwcadBatchPlot.StampLibraryForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZwcadBatchPlot"
        Title="印章库管理"
        Width="900" Height="440" MinWidth="720" MinHeight="340"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- 图标：向右上箭头（录入/导出/导入）、对勾、叉。都按线性描边画，缩放不糊。 -->
            <Geometry x:Key="GlyphArrowGeometry">M 1,10.5 L 10.5,1 M 4.6,1 L 10.5,1 L 10.5,6.9</Geometry>
            <Geometry x:Key="GlyphCheckGeometry">M 1.2,6.2 L 4.4,9.4 L 10.2,1.8</Geometry>
            <Geometry x:Key="GlyphCrossGeometry">M 1.4,1.4 L 9.4,9.4 M 9.4,1.4 L 1.4,9.4</Geometry>
            <Geometry x:Key="GlyphFolderGeometry">M 1,3.2 L 4.6,3.2 L 5.8,4.6 L 11,4.6 L 11,10.6 L 1,10.6 Z</Geometry>

            <!--
                单元格模板：右下各 1 像素细线拼出表格网格。
                必须自己画 —— WPF DataGrid 的网格线是由单元格模板里的 Border 呈现的，
                默认模板被替换（PluginGridStyle）后就只剩一片白。
            -->
            <Style x:Key="StampCellStyle" TargetType="DataGridCell">
                <Setter Property="BorderBrush" Value="{DynamicResource Plugin.GridLineBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Plugin.GridSelectionBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource Plugin.GridSelectionForeground}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 表头：浅灰底 + 同样细线，文字不加粗（与截图一致）。 -->
            <Style x:Key="StampHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource Plugin.GridHeaderBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Plugin.GridLineBrush}"
                                    BorderThickness="0,0,1,1"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 行：占位行（用来铺满空白网格）不可点、不可聚焦，双击直接穿透到表格 → 录入新印章。 -->
            <Style x:Key="StampRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Setter Property="Focusable" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 行内状态文字：平时按语义着色（绿=可用 / 红=过期），选中行换成高亮前景，
                 否则深绿字压在蓝色选中条上直接看不见。 -->
            <Style x:Key="StampStatusTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{Binding StatusBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                 Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Plugin.GridSelectionForeground}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 删除列的对勾：同理，选中行改成高亮前景。 -->
            <Style x:Key="StampDeleteGlyphStyle" TargetType="Path">
                <Setter Property="Stroke" Value="{DynamicResource PluginGlyphGreenBrush}" />
                <Setter Property="StrokeThickness" Value="1.8" />
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                 Value="True">
                        <Setter Property="Stroke" Value="{DynamicResource Plugin.GridSelectionForeground}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 印章列表 -->
        <Grid Grid.Row="0" Grid.Column="0">
            <DataGrid x:Name="_grid"
                      Style="{StaticResource PluginGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowHeight="22"
                      ColumnHeaderHeight="24"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      CellStyle="{StaticResource StampCellStyle}"
                      ColumnHeaderStyle="{StaticResource StampHeaderStyle}"
                      RowStyle="{StaticResource StampRowStyle}"
                      AlternatingRowBackground="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                      RowBackground="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                      MouseDoubleClick="Grid_MouseDoubleClick"
                      PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                      ContextMenuOpening="Grid_ContextMenuOpening">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Binding="{Binding IndexText}" Width="36" />
                    <DataGridTemplateColumn Header="预览" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Preview}" Stretch="Uniform" Height="18"
                                       HorizontalAlignment="Left" SnapsToDevicePixels="True" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="印章名" Binding="{Binding Name}" Width="72" />
                    <DataGridTemplateColumn Header="删除" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="RowDelete_Click" Tag="{Binding}"
                                        Style="{DynamicResource PluginFlatButtonStyle}"
                                        Padding="2,0" HorizontalAlignment="Left"
                                        Visibility="{Binding ShowDelete, Converter={StaticResource BoolToVis}}"
                                        ToolTip="从印章库删除这枚印章">
                                    <Path Data="{StaticResource GlyphCheckGeometry}"
                                          Style="{StaticResource StampDeleteGlyphStyle}" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="授权码" Binding="{Binding AuthCodeText}" Width="56" />
                    <DataGridTextColumn Header="印章有效期" Binding="{Binding ValidToText}" Width="78" />
                    <DataGridTextColumn Header="印章尺寸(mm)" Binding="{Binding SizeText}" Width="88" />
                    <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="50" />
                    <DataGridTemplateColumn Header="状态" Width="*" MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StampStatusTextStyle}"
                                           ToolTip="{Binding StatusToolTip}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 空白处的水印提示（条目少到没铺满表格时显示，与截图中"双击空白处录入新印章"对应） -->
            <Border x:Name="_emptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="8,3" IsHitTestVisible="False"
                    Background="{DynamicResource Plugin.GridHeaderBackground}"
                    BorderBrush="{DynamicResource Plugin.GridLineBrush}" BorderThickness="1">
                <TextBlock Text="双击空白处录入新印章"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            </Border>
        </Grid>

        <!-- 右侧竖排按钮 -->
        <Grid Grid.Row="0" Grid.Column="1" Width="132" Margin="10,2,0,4">
            <StackPanel VerticalAlignment="Top">
                <Button x:Name="_addButton" Style="{DynamicResource PluginFlatButtonStyle}" Margin="0,0,0,26"
                        ToolTip="选择印章图片后填写名称、类型、宽度与有效期。也可以在列表空白处双击。">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GlyphArrowGeometry}"
                              Stroke="{DynamicResource PluginGlyphGreenBrush}" StrokeThickness="1.6"
                              Width="11" Height="11" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock Text="录入新印章" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="_exportButton" Style="{DynamicResource PluginFlatButtonStyle}" Margin="0,0,0,8"
                        ToolTip="把印章库与图片打包成一个文件，便于拷给同事或在别的机器导入。">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GlyphArrowGeometry}"
                              Stroke="{DynamicResource PluginGlyphGreenBrush}" StrokeThickness="1.6"
                              Width="11" Height="11" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock Text="导出印章库" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="_importButton" Style="{DynamicResource PluginFlatButtonStyle}" Margin="0,0,0,20"
                        ToolTip="从导出的印章库文件追加导入，同名印章会作为新条目加入，不会覆盖现有条目。">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GlyphArrowGeometry}"
                              Stroke="{DynamicResource PluginGlyphGreenBrush}" StrokeThickness="1.6"
                              Width="11" Height="11" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock Text="导入印章库" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 两个文件夹相关的操作放在第二组：它们不产生新条目（只是把已有图片登记进来），
                     视觉上和上面三个按钮区分开。 -->
                <Button x:Name="_scanFolderButton" Style="{DynamicResource PluginFlatButtonStyle}" Margin="0,0,0,8"
                        ToolTip="把「签章」图片文件夹里还没入库的图片登记成印章（名称取文件名）。往该文件夹里丢图片后点一下即可。">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GlyphFolderGeometry}"
                              Stroke="{DynamicResource PluginGlyphGreenBrush}" StrokeThickness="1.4"
                              Width="12" Height="12" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock Text="扫描文件夹" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="_openFolderButton" Style="{DynamicResource PluginFlatButtonStyle}"
                        ToolTip="打开插件目录下的「签章」图片文件夹；插件目录不可写时自动改用用户数据目录。">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GlyphFolderGeometry}"
                              Stroke="{DynamicResource PluginGlyphGreenBrush}" StrokeThickness="1.4"
                              Width="12" Height="12" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock Text="打开图片目录" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom">
                <Button x:Name="_okButton" Style="{DynamicResource PluginFlatButtonStyle}" Margin="0,0,0,6"
                        IsDefault="True"
                        ToolTip="关闭窗口。所有修改都已在操作时立即保存。">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GlyphCheckGeometry}"
                              Stroke="{DynamicResource PluginGlyphGreenBrush}" StrokeThickness="1.9"
                              Width="11" Height="11" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock Text="确定" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="_cancelButton" Style="{DynamicResource PluginFlatButtonStyle}"
                        IsCancel="True"
                        ToolTip="关闭窗口。注意：修改是即时保存的，关闭不会撤销已做的改动。">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GlyphCrossGeometry}"
                              Stroke="{DynamicResource PluginGlyphGreenBrush}" StrokeThickness="1.9"
                              Width="11" Height="11" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="取消" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 底部：当前印章库文件（右端是导入时的去白底开关）。
             两列而不是同一格叠放：路径很长，叠在一起时会压到复选框上。 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" Padding="2,5,2,1"
                BorderBrush="{DynamicResource Plugin.GridLineBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="_libraryPathText" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <CheckBox Grid.Column="1" x:Name="_removeBackgroundCheck" Content="导入时自动去白底" IsChecked="True"
                          VerticalAlignment="Center"
                          ToolTip="录入新印章、替换图片、扫描文件夹时，把接近纯白的底色置为透明。印章九成是白底扫描件，建议勾选；已是透明 PNG 勾不勾都行。" />
            </Grid>
        </Border>
    </Grid>
</Window>
