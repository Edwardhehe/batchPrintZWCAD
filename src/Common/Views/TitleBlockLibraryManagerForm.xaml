<Window x:Class="ZwcadBatchPlot.TitleBlockLibraryManagerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZwcadBatchPlot"
        Title="图框信息库管理"
        Width="760" Height="360"
        MinWidth="700" MinHeight="320"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部按钮行（对应原 FlowLayoutPanel，不换行，可横向滚动） -->
        <ScrollViewer DockPanel.Dock="Top"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Margin="8,5,8,4">
                <Button x:Name="_saveButton" Content="保存修改" MinWidth="96" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnSaveClick" />
                <Button Content="删除选中" MinWidth="96" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnDeleteClick" />
                <Button Content="重新读取" MinWidth="96" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnReloadClick" />
                <Button Content="导入图框库" MinWidth="104" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnImportClick" />
                <Button Content="导出图框库" MinWidth="104" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnExportClick" />
                <Button Content="打开配置目录" MinWidth="112" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnOpenFolderClick" />
                <Button Content="关闭" MinWidth="72" Margin="0,0,0,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnCloseClick" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Height="28">
            <TextBlock x:Name="_status" VerticalAlignment="Center" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- 行数据表格（列在 code-behind 中按原 DataGridView 列定义构建） -->
        <DataGrid x:Name="_grid"
                  Style="{StaticResource PluginGridStyle}"
                  Margin="0"
                  Sorting="GridSorting"
                  LoadingRow="GridLoadingRow"
                  MouseDoubleClick="GridMouseDoubleClick"
                  ContextMenuOpening="GridContextMenuOpening"
                  PreviewMouseRightButtonDown="GridPreviewMouseRightButtonDown"
                  Validation.Error="GridValidationError">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- 当前 CAD 中已存在的图框整行淡粉色，方便用户快速认出新录入条目 -->
                        <DataTrigger Binding="{Binding PresentInDrawing}" Value="True">
                            <Setter Property="Background" Value="#FFE6E6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu x:Name="_rowMenu">
                    <MenuItem Header="编辑" Click="OnEditMenuItemClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</Window>
