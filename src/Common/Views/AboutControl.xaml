<UserControl x:Class="ZwcadBatchPlot.AboutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei" FontSize="13">
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="LA 批量打印" FontSize="20" FontWeight="Bold"
                       Foreground="#FF1A73E8" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding VersionText}" FontSize="12"
                       Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 分隔线 -->
        <Border Grid.Row="1" Height="1" Background="#FFE0E0E0" Margin="0,0,0,12"/>

        <!-- 信息 -->
        <StackPanel Grid.Row="2" Margin="12,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="设计：" Foreground="#FF555555" Width="60"/>
                <TextBlock Text="爱德华hehe"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="邮箱：" Foreground="#FF555555" Width="60"/>
                <TextBlock Text="527152927@qq.com">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- plain text; click-to-copy handled by code-behind if needed -->
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="QQ群：" Foreground="#FF555555" Width="60"/>
                <TextBlock Text="829218271"/>
            </StackPanel>
        </StackPanel>

        <!-- 分隔线 -->
        <Border Grid.Row="3" Height="1" Background="#FFE0E0E0" Margin="0,10,0,12"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Content="QQ 群" Width="86" Height="28"
                    Click="OnQqGroupClick" Margin="0,0,8,0"/>
            <Button Content="确定" Width="76" Height="28"
                    Click="OnOkClick" IsDefault="True"/>
        </StackPanel>
    </Grid>
</UserControl>
