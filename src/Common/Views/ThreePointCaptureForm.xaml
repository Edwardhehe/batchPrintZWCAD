<Window x:Class="ZwcadBatchPlot.ThreePointCaptureForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图签信息入库"
        Width="268"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10,8,10,10">
        <!-- 底部：状态 + 确定/取消 -->
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="_status" Foreground="DimGray" TextWrapping="Wrap" Margin="0,4,0,8"
                       Text="点某个「范围」按钮去图纸上框选两个角点；点 × 清除该项。" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="确定" IsDefault="True" MinHeight="26"
                        Style="{StaticResource PluginButtonStyle}" Click="OnOkClick" />
                <Button Grid.Column="2" Content="取消" MinHeight="26"
                        Style="{StaticResource PluginButtonStyle}" Click="OnCancelClick" />
            </Grid>
        </StackPanel>

        <!-- 顶部：入库名称 + 排序优先级 -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="入库名称" HorizontalAlignment="Center" Margin="0,0,0,3" />
            <TextBox x:Name="_nameBox" MinHeight="24" Padding="4,2" MaxLength="60"
                     VerticalContentAlignment="Center" />
            <TextBlock x:Name="_nameHint" Foreground="DimGray" TextWrapping="Wrap"
                       Margin="0,3,0,0" Text="名称自动取三个锚点文字，可在这里改。" />

            <TextBlock Text="排序优先级" HorizontalAlignment="Center" Margin="0,10,0,3" />
            <ComboBox x:Name="_priorityBox" MinHeight="24" />
            <TextBlock Foreground="DimGray" TextWrapping="Wrap" Margin="0,3,0,0"
                       Text="数字越小越优先，同时命中多条图签时先看这一项。" />
        </StackPanel>

        <!-- 中部：字段范围按钮列表 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="0,10,0,0">
            <StackPanel x:Name="_fieldPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>
