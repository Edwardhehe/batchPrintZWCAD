<Window x:Class="ZwcadBatchPlot.ImageProcessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZwcadBatchPlot"
        Title="图片处理"
        Width="700" SizeToContent="Height"
        MinWidth="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                棋盘格底：透明 PNG 的空白区在纯白上和白底签名分不清，
                用灰白方格才能一眼看出「这里已经是透明的」。
            -->
            <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                          Viewport="0,0,16,16" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#FFFFFF">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,16,16" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#E2E2E2">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,8,8" />
                                    <RectangleGeometry Rect="8,8,8,8" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <Geometry x:Key="GlyphCheckGeometry">M 1.2,6.2 L 4.4,9.4 L 10.2,1.8</Geometry>
            <Geometry x:Key="GlyphCrossGeometry">M 1.4,1.4 L 9.4,9.4 M 9.4,1.4 L 1.4,9.4</Geometry>

            <Style x:Key="SectionCheckStyle" TargetType="CheckBox">
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="IndentRowStyle" TargetType="Grid">
                <Setter Property="Margin" Value="20,6,0,0" />
            </Style>

            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Plugin.HintBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="12,10,12,12">

        <!-- 预览：棋盘格底 + 处理后效果 -->
        <Border Height="248" Background="{StaticResource CheckerBrush}" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <Grid>
                <Image x:Name="_preview" Stretch="Uniform" Margin="8" />
                <TextBlock x:Name="_previewHint" Text="图片读取失败" Foreground="#B00020"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <TextBlock x:Name="_sizeText" Margin="0,6,0,0" TextWrapping="Wrap" />

        <!-- 去底色 -->
        <CheckBox x:Name="_removeBgCheck" Style="{StaticResource SectionCheckStyle}"
                  Content="去底色（把接近纯白的底色变成透明）"
                  ToolTip="扫描件、手机拍的签名都有灰白底。去掉之后盖在图纸上不会出现一块白方块。" />
        <Grid x:Name="_thresholdRow" Style="{StaticResource IndentRowStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="阈值" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Slider Grid.Column="1" x:Name="_thresholdSlider" Minimum="150" Maximum="254"
                    TickFrequency="8" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    ValueChanged="_thresholdSlider_ValueChanged"
                    ToolTip="亮度高于该值的像素变全透明。默认 246 只去纯白；底灰偏重就往下调（220 左右），笔画变淡则往回调。" />
            <TextBox Grid.Column="2" x:Name="_thresholdBox" Width="46" Margin="8,0,0,0"
                     VerticalContentAlignment="Center" TextAlignment="Center"
                     TextChanged="_thresholdBox_TextChanged"
                     ToolTip="可直接输入数字：150～254。" />
            <TextBlock Grid.Column="3" Text="越高去得越干净" Style="{StaticResource HintTextStyle}" />
        </Grid>

        <!-- 修剪空白边 -->
        <CheckBox x:Name="_trimCheck" Style="{StaticResource SectionCheckStyle}"
                  Content="修剪四周空白边（按透明区域自动识别内容边界）"
                  ToolTip="去掉图片四周多余的透明边，让签名/印章在槽位里显示得更大、定位更准。需要先去底色，否则白底是不透明的，没有可剪的空白。" />
        <Grid x:Name="_trimRow" Style="{StaticResource IndentRowStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="保留边距" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" x:Name="_trimPadBox" Width="52" VerticalContentAlignment="Center"
                     TextAlignment="Center" TextChanged="_trimPadBox_TextChanged"
                     ToolTip="修剪后向外多留的空白（像素）。留 0～4 像素可以避免笔画边缘的抗锯齿被裁掉。" />
            <TextBlock Grid.Column="2" Text="像素" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock Grid.Column="3" Text="建议 2～6" Style="{StaticResource HintTextStyle}" />
        </Grid>

        <!-- 清晰度 -->
        <CheckBox x:Name="_sharpnessCheck" Style="{StaticResource SectionCheckStyle}"
                  Content="清晰度（正数锐化笔画边缘，负数柔化去毛刺）"
                  ToolTip="扫描件、手机拍的签名常常偏软发虚：往正数调能强化笔画边缘；噪点或毛边太多就往负数调柔化。" />
        <Grid x:Name="_sharpnessRow" Style="{StaticResource IndentRowStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="强度" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Slider Grid.Column="1" x:Name="_sharpnessSlider" Minimum="-100" Maximum="100"
                    TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    ValueChanged="_sharpnessSlider_ValueChanged"
                    ToolTip="0 = 原样。正数锐化（+30 左右最自然），负数柔化（-30 左右可压掉毛刺）。" />
            <TextBox Grid.Column="2" x:Name="_sharpnessBox" Width="46" Margin="8,0,0,0"
                     VerticalContentAlignment="Center" TextAlignment="Center"
                     TextChanged="_sharpnessBox_TextChanged"
                     ToolTip="可直接输入数字：-100～100，0 表示不处理。" />
            <TextBlock Grid.Column="3" Text="0 = 原样" Style="{StaticResource HintTextStyle}" />
        </Grid>

        <!-- 调整尺寸 -->
        <CheckBox x:Name="_resizeCheck" Style="{StaticResource SectionCheckStyle}"
                  Content="调整尺寸（重采样图片像素，不改变出图时在图框里的实际大小）"
                  ToolTip="用于把 3000 像素的扫描件压到几百像素、减小 PDF 体积；或把过小的图放大以减轻模糊。出图的实际大小由「印章宽度」和图框槽位决定，与这里无关。" />
        <Grid x:Name="_resizeRow" Style="{StaticResource IndentRowStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="宽度" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" x:Name="_resizeWidthBox" Width="64" VerticalContentAlignment="Center"
                     TextAlignment="Center" TextChanged="_resizeWidthBox_TextChanged"
                     ToolTip="目标宽度。未勾选「约束比例」后可单独指定高度；勾着时高度会跟着自动算。" />
            <TextBlock Grid.Column="2" Text="高度" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Grid.Column="3" x:Name="_resizeHeightBox" Width="64" VerticalContentAlignment="Center"
                     TextAlignment="Center" TextChanged="_resizeHeightBox_TextChanged"
                     ToolTip="目标高度。勾着「约束比例」时这里由宽度自动推出（不可编辑）；取消勾选后可自由填写，但图会被压扁或拉长。" />
            <ComboBox Grid.Column="4" x:Name="_resizeUnitCombo" Width="128" Margin="8,0,0,0"
                      VerticalContentAlignment="Center"
                      SelectionChanged="_resizeUnitCombo_SelectionChanged"
                      ToolTip="像素：图片的实际像素尺寸；毫米：按 300dpi 换算，便于对着印章实际尺寸输入。宽高共用同一个单位。">
                <ComboBoxItem Content="像素 (px)" />
                <ComboBoxItem Content="毫米 (mm，300dpi)" />
            </ComboBox>
            <CheckBox Grid.Column="5" x:Name="_lockRatioCheck" Content="约束比例"
                      VerticalAlignment="Center" Margin="12,0,0,0" IsChecked="True"
                      Checked="_lockRatioCheck_Changed" Unchecked="_lockRatioCheck_Changed"
                      ToolTip="保持原图长宽比：只按宽度缩放、高度自动跟随，图片不会变形。要做「压扁/拉长」的特殊效果才取消勾选。" />
            <TextBlock Grid.Column="6" x:Name="_resizeHint" Style="{StaticResource HintTextStyle}"
                       Margin="10,0,0,0" />
        </Grid>

        <!-- 分辨率：决定「毫米」怎么换算，也决定图片记录的物理尺寸。不改变像素数量。 -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="分辨率" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" x:Name="_dpiBox" Width="58" VerticalContentAlignment="Center"
                     TextAlignment="Center" TextChanged="_dpiBox_TextChanged"
                     ToolTip="每英寸像素数（DPI）。只影响「毫米」换算方向和图片记录的物理尺寸，像素数量不变。" />
            <TextBlock Grid.Column="2" Text="dpi" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock Grid.Column="3" x:Name="_dpiHint" Style="{StaticResource HintTextStyle}" />
        </Grid>

        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Plugin.HintBrush}" TextWrapping="Wrap"
                   Text="提示：处理结果会写回库里的图片，原图自动留一份 .orig.png 备份，随时可「恢复原图」。反复调整都从原图重算，不会越调越糊。" />

        <!-- 底部按钮 -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="_restoreButton" MinWidth="104" Padding="8,4" IsEnabled="False"
                    Style="{DynamicResource PluginFlatButtonStyle}"
                    ToolTip="放弃所有处理，恢复成最初导入的那张图。">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 1,6 A 5,5 0 1 1 3.2,10.4 M 1,2.2 L 1,6.2 L 5,6.2"
                          Stroke="{DynamicResource PluginGlyphGreenBrush}" StrokeThickness="1.7"
                          Width="12" Height="12" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <TextBlock Text="恢复原图" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="_okButton" MinWidth="96" Padding="10,4" Margin="0,0,10,0"
                        Style="{DynamicResource PluginFlatButtonStyle}" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GlyphCheckGeometry}"
                              Stroke="{DynamicResource PluginGlyphGreenBrush}" StrokeThickness="1.9"
                              Width="11" Height="11" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock Text="应用" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="_cancelButton" MinWidth="96" Padding="10,4"
                        Style="{DynamicResource PluginFlatButtonStyle}" IsCancel="True">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GlyphCrossGeometry}"
                              Stroke="{DynamicResource PluginGlyphGreenBrush}" StrokeThickness="1.9"
                              Width="11" Height="11" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock Text="取消" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
