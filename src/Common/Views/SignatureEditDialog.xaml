<Window x:Class="ZwcadBatchPlot.SignatureEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZwcadBatchPlot"
        Title="签名"
        Width="372" SizeToContent="Height"
        MinWidth="352"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <Geometry x:Key="GlyphCheckGeometry">M 1.2,6.2 L 4.4,9.4 L 10.2,1.8</Geometry>
            <Geometry x:Key="GlyphCrossGeometry">M 1.4,1.4 L 9.4,9.4 M 9.4,1.4 L 1.4,9.4</Geometry>

            <!--
                DatePicker 内部的输入框是 DatePickerTextBox（TextBox 的派生类），
                取不到 TextBox 的隐式样式，深色主题下会变成黑底深灰字（几乎看不见）。
                这里单独给它上色。与印章录入框保持一致。
            -->
            <Style TargetType="DatePickerTextBox">
                <Setter Property="Background" Value="{DynamicResource Plugin.InputBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource Plugin.HighlightBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="12,10,12,10">

        <!-- 签名图片预览：固定白底，透明 PNG 的黑色笔画才看得清。双击可换图。 -->
        <Border Height="132" Background="White" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                ToolTip="双击更换签名图片…">
            <Grid>
                <Image x:Name="_preview" Stretch="Uniform" Margin="6" />
                <TextBlock x:Name="_previewHint" Text="未选择图片" Foreground="#999999"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 图片处理入口（去底色 / 修剪空白 / 调整尺寸） -->
        <Button x:Name="_processButton" HorizontalAlignment="Right" Margin="0,4,0,0"
                Style="{DynamicResource PluginFlatButtonStyle}" Content="图片处理…"
                ToolTip="去底色、修剪四周空白、调整像素尺寸与清晰度，带实时预览。处理后的图会作为这个签名的图片保存。" />

        <!-- 签名名 -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="签名名：" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" x:Name="_nameBox" VerticalContentAlignment="Center"
                     ToolTip="一般填人名。图框「签章设置」里选签名时看到的就是这个名字。" />
        </Grid>

        <!-- 不透明度 -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="不透明度：" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" x:Name="_opacityBox" Width="62" HorizontalAlignment="Left"
                     VerticalContentAlignment="Center"
                     ToolTip="0～1，1 为完全不透明。手写签名一般保持 1。" />
            <TextBlock Grid.Column="2" Text="0～1，1 为完全不透明" Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Plugin.HintBrush}" />
        </Grid>

        <!-- 有效期起 -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="有效期起：" Style="{StaticResource FieldLabel}" />
            <DatePicker Grid.Column="1" x:Name="_validFromPicker" SelectedDateFormat="Long"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource Plugin.InputBackground}"
                        BorderBrush="{DynamicResource Plugin.InputBorder}"
                        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                        ToolTip="从这天起才允许使用。留空（按 Delete 清空）表示不限。" />
        </Grid>

        <!-- 有效期止 -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="有效期止：" Style="{StaticResource FieldLabel}" />
            <DatePicker Grid.Column="1" x:Name="_validToPicker" SelectedDateFormat="Long"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource Plugin.InputBackground}"
                        BorderBrush="{DynamicResource Plugin.InputBorder}"
                        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                        ToolTip="到期后出图不再用这个签名。留空（按 Delete 清空）表示长期有效。" />
        </Grid>

        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Plugin.HintBrush}"
                   Text="有效期留空表示不限。两个日期都填时，只有落在区间内出图才会盖章。" />

        <!-- 底部按钮：左确定、右取消（扁平无边框 + 绿色图标，各自居中于半宽） -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="_okButton" HorizontalAlignment="Center"
                    Style="{DynamicResource PluginFlatButtonStyle}" IsDefault="True" Padding="4,3">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource GlyphCheckGeometry}"
                          Stroke="{DynamicResource PluginGlyphGreenBrush}" StrokeThickness="1.9"
                          Width="11" Height="11" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <TextBlock Text="确定" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" x:Name="_cancelButton" HorizontalAlignment="Center"
                    Style="{DynamicResource PluginFlatButtonStyle}" IsCancel="True" Padding="4,3">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource GlyphCrossGeometry}"
                          Stroke="{DynamicResource PluginGlyphGreenBrush}" StrokeThickness="1.9"
                          Width="11" Height="11" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <TextBlock Text="取消" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</Window>
