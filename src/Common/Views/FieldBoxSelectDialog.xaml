<Window x:Class="ZwcadBatchPlot.FieldBoxSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZwcadBatchPlot"
        Title="设置图框字段与纸张"
        Width="460" Height="436"
        MinWidth="430" MinHeight="410"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- Row 0: 打印范围（可重新框选），Row 1-7: 字段（图名/图号必选，其余可选），Row 8: 纸张 -->
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
            <!-- Row 9: 提示 -->
            <RowDefinition Height="*" />
            <!-- Row 10: 按钮 -->
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- 打印范围：显示当前尺寸，提供"框选"按钮供用户修正自动识别的外框。 -->
        <Label Grid.Row="0" Grid.Column="0" Content="打印范围" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_printAreaStatus" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="DimGray" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="框选" MinWidth="60" Margin="6,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnSelectPrintAreaClick" />
        </Grid>

        <!-- 图名/图号为必选字段，保存前必须完成框选。 -->
        <Label Grid.Row="1" Grid.Column="0" Content="图名 *" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_titleStatus" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="DimGray" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="框选" MinWidth="60" Margin="6,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnSelectTitleClick" />
            <Button Grid.Column="2" Content="清除" MinWidth="60" Margin="2,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnClearTitleClick" />
        </Grid>

        <Label Grid.Row="2" Grid.Column="0" Content="图号 *" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_numberStatus" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="DimGray" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="框选" MinWidth="60" Margin="6,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnSelectNumberClick" />
            <Button Grid.Column="2" Content="清除" MinWidth="60" Margin="2,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnClearNumberClick" />
        </Grid>

        <!-- 日期 -->
        <Label Grid.Row="3" Grid.Column="0" Content="日期" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
        <Grid Grid.Row="3" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_dateStatus" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="DimGray" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="框选" MinWidth="60" Margin="6,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnSelectDateClick" />
            <Button Grid.Column="2" Content="清除" MinWidth="60" Margin="2,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnClearDateClick" />
        </Grid>

        <!-- 版次 -->
        <Label Grid.Row="4" Grid.Column="0" Content="版次" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
        <Grid Grid.Row="4" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_revisionStatus" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="DimGray" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="框选" MinWidth="60" Margin="6,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnSelectRevisionClick" />
            <Button Grid.Column="2" Content="清除" MinWidth="60" Margin="2,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnClearRevisionClick" />
        </Grid>

        <!-- 设计阶段 -->
        <Label Grid.Row="5" Grid.Column="0" Content="设计阶段" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
        <Grid Grid.Row="5" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_phaseStatus" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="DimGray" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="框选" MinWidth="60" Margin="6,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnSelectPhaseClick" />
            <Button Grid.Column="2" Content="清除" MinWidth="60" Margin="2,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnClearPhaseClick" />
        </Grid>

        <!-- 信息1/信息2为用户自定义可选字段，可用于后续文件名命名。 -->
        <Label Grid.Row="6" Grid.Column="0" Content="信息1" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
        <Grid Grid.Row="6" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_info1Status" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="DimGray" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="框选" MinWidth="60" Margin="6,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnSelectInfo1Click" />
            <Button Grid.Column="2" Content="清除" MinWidth="60" Margin="2,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnClearInfo1Click" />
        </Grid>

        <Label Grid.Row="7" Grid.Column="0" Content="信息2" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
        <Grid Grid.Row="7" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_info2Status" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="DimGray" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="框选" MinWidth="60" Margin="6,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnSelectInfo2Click" />
            <Button Grid.Column="2" Content="清除" MinWidth="60" Margin="2,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnClearInfo2Click" />
        </Grid>

        <!-- 纸张：默认按打印范围自动识别，重新框选打印范围时同步刷新，也可手动修改。 -->
        <Label Grid.Row="8" Grid.Column="0" Content="纸张" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
        <Grid Grid.Row="8" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="_paperName" Grid.Column="0" IsEditable="False"
                      VerticalContentAlignment="Center" MaxDropDownHeight="330" />
            <Button Grid.Column="1" Content="任意纸张…" MinWidth="100" Margin="6,0,0,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnPickArbitraryPaperClick" />
        </Grid>

        <!-- 提示 -->
        <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                   Foreground="DimGray" FontSize="10" TextWrapping="Wrap"
                   Text="图名、图号为必选。点击&quot;框选&quot;在 CAD 中框选对应区域，已选区域以红色临时框标识；纸张按打印范围自动识别，可手动修改。" />

        <!-- 按钮（原 FlowLayoutPanel RightToLeft：先加的在最右 → 视觉顺序 取消/跳过/确定） -->
        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="_cancelButton" Content="取消" MinWidth="76" Margin="0,0,6,0"
                    Style="{StaticResource PluginButtonStyle}" IsCancel="True" />
            <Button Content="跳过" MinWidth="76" Margin="0,0,6,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnSkipClick" />
            <Button Content="确定" MinWidth="76"
                    Style="{StaticResource PluginButtonStyle}" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
