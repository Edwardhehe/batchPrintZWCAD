<Window x:Class="ZwcadBatchPlot.ThreePointLibraryManagerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZwcadBatchPlot"
        Title="三点图签信息库管理"
        Width="780" Height="430"
        MinWidth="720" MinHeight="360"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <ScrollViewer DockPanel.Dock="Top"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Margin="8,5,8,4">
                <Button Content="新建图签信息" MinWidth="132" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnAddClick"
                        ToolTip="点取三个不同的文字（单行/多行均可，尽量分散，共线也可；块内文字也可用）后弹出录入窗：填名称、排序优先级，逐项点「范围」按钮框选字段。" />
                <Button Content="重新录入图签信息" MinWidth="132" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnRecaptureClick"
                        ToolTip="对选中的条目重新点三个锚点并重框字段范围（名称与其它设置保持不变）。" />
                <Button Content="删除选中" MinWidth="96" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnDeleteClick" />
                <Button Content="重命名" MinWidth="88" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnRenameClick"
                        ToolTip="修改选中条目的名称。新建时名称按三个锚点文字自动生成，可在这里改成更好认的名字。" />
                <Button Content="试识别" MinWidth="88" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnProbeClick"
                        ToolTip="在当前图纸上按选中条目找锚点三元组，报告命中数量与字段取值，用来验证录入是否正确。" />
                <Button Content="打开配置目录" MinWidth="112" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnOpenFolderClick" />
                <Button Content="关闭" MinWidth="72"
                        Style="{StaticResource PluginButtonStyle}" Click="OnCloseClick" />
            </StackPanel>
        </ScrollViewer>

        <Border DockPanel.Dock="Bottom" Padding="10,4,10,8">
            <TextBlock x:Name="_status" Foreground="DimGray" TextWrapping="Wrap"
                       Text="三点图签：直接点三个不同的文字定位图签（单行/多行均可），三点尽量分散；共线也能用，但会降级为等比缩放 + 旋转（不支持镜像与非等比）。字段范围随三点变换，支持块内文字、旋转、镜像与不同比例图纸。" />        </Border>

        <DataGrid x:Name="_grid" Margin="8,0,8,4"
                  Style="{StaticResource PluginGridStyle}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  MouseDoubleClick="OnGridDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="170" IsReadOnly="True" />
                <DataGridTextColumn Header="优先级" Binding="{Binding PriorityText}" Width="60" IsReadOnly="True" />
                <DataGridTextColumn Header="三个锚点文字" Binding="{Binding AnchorText}" Width="230" IsReadOnly="True" />
                <DataGridTextColumn Header="字段" Binding="{Binding FieldSummary}" Width="*" MinWidth="180" IsReadOnly="True" />
                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedText}" Width="130" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
