<Window x:Class="ZwcadBatchPlot.TitleBlockModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图框模式"
        Width="920" Height="520"
        MinWidth="720" MinHeight="360"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="10,8,10,4" TextWrapping="Wrap"
                   Text="按纸张 1:1 比较图名、图号角点相对图纸右下角的位置。相差在 1mm 以内视为同一模式，所以同一套图框的 A2、A3 只要右下角关系一致，就会归在一起。坐标单位是毫米，向左、向上为正。" />
        <DockPanel DockPanel.Dock="Bottom" Margin="10,4,10,8">
            <Button Content="关闭" MinWidth="72" DockPanel.Dock="Right" IsCancel="True" IsDefault="True"
                    Style="{StaticResource PluginButtonStyle}" Click="OnCloseClick" />
            <TextBlock x:Name="_summary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <DataGrid x:Name="_grid" Margin="8,0,8,0" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  Style="{StaticResource PluginGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="模式" Binding="{Binding Label}" Width="64" />
                <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="52" />
                <DataGridTextColumn Header="图幅" Binding="{Binding Papers}" Width="140" />
                <DataGridTextColumn Header="图名角点" Binding="{Binding TitleText}" Width="210" />
                <DataGridTextColumn Header="图号角点" Binding="{Binding NumberText}" Width="210" />
                <DataGridTextColumn Header="图框" Binding="{Binding Blocks}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
