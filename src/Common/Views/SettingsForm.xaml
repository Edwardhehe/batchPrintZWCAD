<Window x:Class="ZwcadBatchPlot.SettingsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZwcadBatchPlot"
        Title="批量打印设置"
        Width="760" Height="600"
        MinWidth="680" MinHeight="540"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <TabControl x:Name="_tabs" Grid.Row="0" SelectionChanged="OnTabsSelectionChanged">

            <!-- ══ 常规 ══ -->
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,10,10,0">
                    <StackPanel>

                        <GroupBox Header="纸张匹配" Margin="0,0,0,4" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="纸张匹配容差(mm)" VerticalAlignment="Center" />
                                <local:NumberBox x:Name="_paperTolerance" Grid.Row="0" Grid.Column="1"
                                                 Min="0.5" Max="20" Increment="0.5" Decimals="1"
                                                 Width="130" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="加长图长边吸附容差(mm)" VerticalAlignment="Center" />
                                <local:NumberBox x:Name="_longPaperSnapTolerance" Grid.Row="1" Grid.Column="1"
                                                 Min="0.5" Max="20" Increment="0.5" Decimals="1"
                                                 Width="130" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 ToolTip="加长图长边吸附到最近 1/8 模数标准加长图的容差；同时影响实际打印纸张和输出名称。" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="矩形框识别" Margin="0,0,0,4" Padding="8">
                            <CheckBox x:Name="_recognizeFourLineRectangleFrames"
                                      Content="识别四条直线或直线型 PL 首尾相连组成的矩形框"
                                      ToolTip="仅在四个独立实体的端点严格首尾相连并通过矩形几何校验时识别；后续沿用原有 PL 矩形框打印流程。" />
                        </GroupBox>

                        <GroupBox Header="打印行为" Margin="0,0,0,4" Padding="8">
                            <StackPanel>
                                <CheckBox x:Name="_openExternalDwgForPlot" Content="跨文件打印时临时打开 DWG" Margin="0,0,0,2" />
                                <CheckBox x:Name="_hideFrameBoundaryWhenPlotting" Content="不打印图框的外边框" Margin="0,0,0,2"
                                          ToolTip="勾选后，正式打印把内容四边各裁 1mm，外框线不再输出；纸张、比例和留白不变。" />
                                <CheckBox x:Name="_plotTransparency" Content="打印透明度" Margin="0,0,0,2"
                                          ToolTip="勾选后按对象透明度输出，对应 CAD 打印对话框中的“打印透明度”；默认开启。" />
                                <CheckBox x:Name="_generatePrintLog" Content="生成打印日志" Margin="0,0,0,2" />
                                <CheckBox x:Name="_convertTextToGeometryWhenPlotting" Content="文字自动转图形打印"
                                          ToolTip="勾选后，PDF/DWF 输出会把 TrueType 文字转换为图形轮廓，避免接收方缺少字体；不会炸开或修改原 DWG 文字。PNG/JPG 本身已是图像输出。默认关闭。" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="输出文件" Margin="0,0,0,4" Padding="8">
                            <CheckBox x:Name="_addSequenceWhenPdfExists" Content="PDF 已存在时自动加序号" />
                        </GroupBox>

                        <GroupBox Header="PDF 合并" Margin="0,0,0,4" Padding="8">
                            <StackPanel>
                                <CheckBox x:Name="_useFileNameAsPdfBookmark" Content="文件名作为书签" Margin="0,0,0,2" />
                                <CheckBox x:Name="_mergePdfByPaperSize" Content="按纸张大小合并" Margin="0,0,0,2" />
                                <TextBlock Foreground="DimGray"
                                           Text="同一纸张尺寸合并到一个 PDF；一批图纸包含多种尺寸时，按尺寸分别生成多个 PDF。" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="完成后操作" Margin="0,0,0,4" Padding="8">
                            <StackPanel>
                                <CheckBox x:Name="_openOutputDirectoryAfterBatchPrint" Content="批量打印单张后，打开所在文件夹" Margin="0,0,0,2" />
                                <CheckBox x:Name="_openMergedPdfAfterMerge" Content="PDF 合并完成后，打开该文件" />
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ 文件名 ══ -->
            <TabItem Header="文件名">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F7FCF7" BorderBrush="Gray" BorderThickness="1" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Foreground="#239137" Text="文件命名用以下字母表示各类信息：" />
                            <Grid Grid.Row="1" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#239137" Text="A：图号" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Foreground="#239137" Text="B：版次" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Foreground="#239137" Text="C：图名" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Foreground="#239137" Text="D：日期" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Foreground="#239137" Text="E：信息1" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#239137" Text="F：信息2" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Foreground="#239137" Text="G：设计阶段" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Foreground="#239137" Text="T：图幅" />
                            </Grid>
                            <TextBlock Grid.Row="2" Foreground="#239137" Text="N：序号（顺序与打印顺序一致）" />
                            <TextBlock Grid.Row="3" Foreground="#239137" Text="输入这些字母本身时请用 \ 转义，例如 \A 输出 A。" Margin="0,4,0,0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="文件命名：" VerticalAlignment="Center" />
                        <TextBox x:Name="_fileNamePattern" Grid.Row="0" Grid.Column="1"
                                 MaxLength="240" VerticalContentAlignment="Center"
                                 TextChanged="OnPatternTextChanged" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="开始序号：" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <local:NumberBox x:Name="_fileNameSequenceStart"
                                             Min="0" Max="999999999" Increment="1" Decimals="0"
                                             Width="105" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                            <TextBlock Text="例如从 100 开始" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="序号位数：" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <local:NumberBox x:Name="_fileNameSequenceDigits"
                                             Min="0" Max="10" Increment="1" Decimals="0"
                                             Width="70" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                            <TextBlock Text="0 表示不补零" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <CheckBox x:Name="_autoFileNameSequenceDigits" Content="按清单总张数自动推断"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      Checked="OnAutoDigitsChanged" Unchecked="OnAutoDigitsChanged" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="输出示例：" Foreground="Navy" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <TextBlock x:Name="_fileNamePreview" Grid.Row="3" Grid.Column="1" Foreground="Navy"
                                   VerticalAlignment="Top" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <GroupBox Grid.Row="2" Header="加长图图名设置" Margin="0,6,0,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="加长图命名格式：" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="_longPaperNameFormat" Width="240" VerticalAlignment="Center"
                                      SelectionChanged="OnLongPaperFormatChanged" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ══ 图纸目录 ══ -->
            <TabItem Header="图纸目录">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="目录字体及绘制相关设置" Padding="6" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,4,0">
                                <TextBlock Text="颜色索引" />
                                <ComboBox x:Name="_directoryColorIndex" Margin="0,2,4,0" MaxDropDownHeight="282" />
                                <Button x:Name="_pickTextAppearanceButton" Content="点选目录文字" MinWidth="108"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Style="{StaticResource PluginButtonStyle}"
                                        ToolTip="在当前活动图纸中点选文字，自动读取颜色、字高、宽度因子、文字样式和图层。"
                                        Click="OnPickTextAppearanceClick" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,4,0">
                                <TextBlock Text="文字高度" />
                                <local:NumberBox x:Name="_directoryTextHeight"
                                                 Min="1" Max="1000000" Increment="10" Decimals="2"
                                                 HorizontalAlignment="Stretch" Margin="0,2,4,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,4,0">
                                <TextBlock Text="宽度因子" />
                                <local:NumberBox x:Name="_directoryTextWidthFactor"
                                                 Min="0.1" Max="10" Increment="0.05" Decimals="2"
                                                 HorizontalAlignment="Stretch" Margin="0,2,4,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Grid.Row="0" Margin="0,0,4,0">
                                <TextBlock Text="文字样式" />
                                <ComboBox x:Name="_directoryTextStyle" Margin="0,2,4,0"
                                          SelectionChanged="OnTextStyleChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Grid.Row="0" Margin="0,0,4,0">
                                <TextBlock Text="图层名称" />
                                <TextBox x:Name="_directoryLayerName" Margin="0,2,4,0" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="5" Grid.Row="0">
                                <TextBlock Text="目录行高" />
                                <local:NumberBox x:Name="_directoryRowHeight"
                                                 Min="1" Max="1000000" Increment="10" Decimals="2"
                                                 HorizontalAlignment="Stretch" Margin="0,2,4,0" />
                                <Button x:Name="_pickRowHeightButton" Content="图中交互" MinWidth="68"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Style="{StaticResource PluginButtonStyle}"
                                        Click="OnPickRowHeightClick" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox x:Name="_directoryDrawHeader" Content="绘制目录表头" Margin="0,0,16,0" />
                                <CheckBox x:Name="_directoryDrawGridLines" Content="绘制目录框线" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="目录内容设置" Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="19" />
                                <RowDefinition Height="76" />
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="_directoryColumnsGrid" Grid.Row="0"
                                      Style="{StaticResource PluginGridStyle}"
                                      SelectionMode="Single"
                                      AutoGenerateColumns="False"
                                      CanUserSortColumns="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="False"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="是否启用" Width="70" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="OnGridEnabledClick" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="文字居中" Width="70" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsChecked="{Binding Centered, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="OnGridCenteredClick" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="目录列名" Width="105" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" Padding="4,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="目录列宽" Width="92" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="OnGridWidthTextChanged"
                                                         BorderThickness="0" Background="Transparent"
                                                         VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="设置列宽" Width="88" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="图中交互" Margin="2,1" Padding="4,0"
                                                        Style="{StaticResource PluginButtonStyle}"
                                                        Click="OnGridPickWidthClick" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="上移" Width="56" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="上移" Margin="2,1" Padding="4,0"
                                                        Style="{StaticResource PluginButtonStyle}"
                                                        Click="OnGridMoveUpClick" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="下移" Width="56" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="下移" Margin="2,1" Padding="4,0"
                                                        Style="{StaticResource PluginButtonStyle}"
                                                        Click="OnGridMoveDownClick" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="1" Text="顺序预览（按实际列宽、行高和字高等比例缩放）"
                                       VerticalAlignment="Bottom" Foreground="DimGray" />
                            <local:DirectoryPreviewControl x:Name="_directoryOrderPreview" Grid.Row="2" Margin="0,2,0,0" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ══ 比例设置 ══ -->
            <TabItem Header="比例设置">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#EFF7FF" Padding="12,7" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="比例识别作用范围" FontWeight="Bold" Foreground="#1C4E79" Margin="0,0,0,4" />
                            <TextBlock Foreground="#374C5E" TextTrimming="CharacterEllipsis"
                                       Text="图框块：按录入纸张短边自动识别任意比例    ·    矩形框：仅识别下方内置及自定义比例" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56*" />
                            <ColumnDefinition Width="44*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="矩形框可识别比例" Padding="8" Margin="0,0,5,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListBox x:Name="_scaleList" Grid.Row="0"
                                         SelectionMode="Extended"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         SelectionChanged="OnScaleListSelectionChanged" />
                                <TextBlock x:Name="_scaleListSummary" Grid.Row="1" Foreground="DimGray" Margin="0,4,0,0" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="自定义比例" Padding="10,8" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="手动输入" FontWeight="Bold" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="82" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="_scaleInput" Grid.Column="0" Margin="0,2,6,2"
                                             VerticalContentAlignment="Center"
                                             PreviewKeyDown="OnScaleInputKeyDown" />
                                    <Button x:Name="_addScaleButton" Grid.Column="1" Content="添加" MinWidth="72"
                                            Margin="0,2" Style="{StaticResource PluginButtonStyle}"
                                            Click="OnAddScaleClick" />
                                </Grid>
                                <TextBlock Foreground="DimGray" Margin="0,4,0,0"
                                           Text="示例：143 = 1:143&#x0a;0.25 = 4:1，也支持直接输入 1:143 或 4:1" />
                                <TextBlock Text="快捷操作" FontWeight="Bold" Margin="0,8,0,4" />
                                <Button x:Name="_pickScaleButton" Content="从图中拾取比例…" MinWidth="150"
                                        HorizontalAlignment="Stretch" Margin="0,2"
                                        Style="{StaticResource PluginButtonStyle}"
                                        Click="OnPickScaleClick" />
                                <Button x:Name="_removeScaleButton" Content="删除选中的自定义比例" MinWidth="170"
                                        HorizontalAlignment="Stretch" Margin="0,2" IsEnabled="False"
                                        Style="{StaticResource PluginButtonStyle}"
                                        Click="OnRemoveScaleClick" />
                                <TextBlock x:Name="_scaleSelectionHint" Foreground="DimGray" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                <TextBlock Foreground="DimGray" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="从图中拾取时，框选图框并选择 A0~A4 图幅，程序按短边计算比例。新增和删除操作将在点击“保存”后生效。" />
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="_footerHint" Grid.Row="1" VerticalAlignment="Center"
                   Foreground="DimGray" TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="恢复默认" MinWidth="96" Margin="0,0,6,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnResetClick" />
            <Button Content="取消" MinWidth="82" Margin="0,0,6,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnCancelClick" />
            <Button Content="保存" MinWidth="82"
                    Style="{StaticResource PluginButtonStyle}" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
