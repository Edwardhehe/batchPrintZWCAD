<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZwcadBatchPlot"
        x:Class="ZwcadBatchPlot.BatchPlotForm"
        Title="LA图框块批量打印 V1.15.6.4"
        Width="900" Height="520"
        MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:RowIndexConverter x:Key="RowIndexConverter" />
            <local:DuplicateBrushConverter x:Key="DuplicateBrushConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- 底部快捷设置栏（原 Dock=Bottom 的 quickBar，最外层底部） -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,3,0,3">
            <Button x:Name="_sortSettingsButton" Content="排序设置" MinWidth="80"
                    Style="{StaticResource PluginButtonStyle}" Margin="0,0,4,0"
                    Click="SortSettings_Click"
                    ToolTip="选择按图号或按图纸位置排序，并设置位置排列方向。" />
            <Button x:Name="_fileNameSettingsButton" Content="文件名设置" MinWidth="90"
                    Style="{StaticResource PluginButtonStyle}" Margin="0,0,4,0"
                    Click="FileNameSettings_Click"
                    ToolTip="配置输出文件名格式、序号位数等，直接跳转到文件名标签页。" />
            <Button x:Name="_directorySettingsButton" Content="目录设置" MinWidth="80"
                    Style="{StaticResource PluginButtonStyle}"
                    Click="DirectorySettings_Click"
                    ToolTip="配置图纸目录列宽、字高等，直接跳转到目录标签页。" />
            <Button x:Name="_generalSettingsButton" Content="常规设置" MinWidth="76"
                    Style="{StaticResource PluginButtonStyle}" Margin="4,0,0,0"
                    Click="GeneralSettings_Click"
                    ToolTip="配置纸张匹配容差、保存路径等常规选项，直接跳转到常规标签页。" />
        </StackPanel>

        <!-- 底部状态栏（原 Dock=Bottom 的 _statusLabel，位于快捷栏上方） -->
        <Border DockPanel.Dock="Bottom" Height="28"
                Background="{x:Static SystemColors.ControlBrush}">
            <TextBlock x:Name="_statusLabel" VerticalAlignment="Center"
                       Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- 顶部：动作行 / 设置行 / 保存路径行 -->
        <StackPanel DockPanel.Dock="Top" Margin="10,4,10,4">
            <!-- 动作行（原 FlowLayoutPanel WrapContents=true → WrapPanel） -->
            <WrapPanel>
                <Button x:Name="_scanButton" Content="扫描当前图" MinWidth="108"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,3,0"
                        Click="ScanCurrentDrawing_Click"
                        ToolTip="扫描当前打开图纸中的全部匹配图框。" />
                <Button x:Name="_scanWindowButton" Content="框选扫描" MinWidth="92"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,3,0"
                        Click="ScanSelectedWindow_Click"
                        ToolTip="回到 CAD 框选区域，只识别框内图框。" />
                <Button x:Name="_addFilesButton" Content="多文件批打" MinWidth="108"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,3,0"
                        Click="AddDwgFiles_Click"
                        ToolTip="选择一个或多个 DWG，加入当前批量打印清单。" />
                <Rectangle Width="1" Height="14" Fill="#CDCDCD"
                           Margin="4,0,12,0" VerticalAlignment="Center" />
                <Button x:Name="_clearButton" Content="清空清单" MinWidth="92"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,3,0"
                        Click="ClearJobs_Click"
                        ToolTip="清空当前清单，不影响 CAD 文件和图框库。" />
                <Rectangle Width="1" Height="14" Fill="#CDCDCD"
                           Margin="4,0,12,0" VerticalAlignment="Center" />
                <Button x:Name="_renumberButton" Content="图号重排" MinWidth="92"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,3,0"
                        Click="RenumberDrawingNumbers_Click"
                        ToolTip="按空间位置重新排序图框，按顺序分配前缀+递增图号。" />
                <Button x:Name="_generateDirectoryButton" Content="生成目录" MinWidth="92"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,3,0"
                        Click="GenerateDrawingDirectory_Click"
                        ToolTip="在当前 CAD 指定基点，生成图纸目录表。" />
            </WrapPanel>

            <!-- 设置行（原 settingsRow 8 列） -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="194" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="输出:" VerticalAlignment="Center" />
                <TextBox x:Name="_outputDirectory" Grid.Column="1"
                         VerticalContentAlignment="Center" Margin="0,0,8,0"
                         TextChanged="OutputDirectory_TextChanged"
                         LostFocus="OutputDirectory_LostFocus" />
                <Button x:Name="_chooseOutputButton" Grid.Column="2" Content="浏览..." MinWidth="84"
                        Style="{StaticResource PluginButtonStyle}" Margin="0,0,6,0"
                        Click="ChooseOutputDirectory_Click"
                        ToolTip="手动选择输出目录。" />
                <TextBlock Grid.Column="3" Text="输出格式:" VerticalAlignment="Center" />
                <ComboBox x:Name="_outputFormatCombo" Grid.Column="4" IsEditable="False"
                          VerticalContentAlignment="Center" Margin="0,0,10,0"
                          SelectionChanged="OutputFormat_SelectionChanged" />
                <TextBlock Grid.Column="5" Text="CTB:" VerticalAlignment="Center" />
                <Grid Grid.Column="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="_styleCombo" Grid.Column="0" IsEditable="False"
                              VerticalContentAlignment="Center" Margin="0,0,4,0"
                              SelectionChanged="Style_SelectionChanged" />
                    <Button x:Name="_styleSettingsButton" Grid.Column="1" Content="设置" MinWidth="56"
                            Style="{StaticResource PluginButtonStyle}" IsEnabled="False"
                            Click="StyleSettings_Click"
                            ToolTip="打开当前选中的 CTB 打印样式进行设置。" />
                </Grid>
                <Button x:Name="_printButton" Grid.Column="7" Content="开始打印" MinWidth="104"
                        Style="{StaticResource PluginButtonStyle}" Margin="8,2,0,0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        Background="#0078D7" Foreground="White" BorderBrush="#005FAA"
                        Click="PrintOrStop_Click"
                        ToolTip="按输出格式打印 PDF/DWF、输出 PNG/JPG 或拆分为 DWG。" />
            </Grid>

            <!-- 保存路径行（原 pathRow） -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="保存路径:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="_savePathModeCombo" Width="210" IsEditable="False"
                          VerticalContentAlignment="Center" Margin="0,0,8,0"
                          SelectionChanged="SavePathMode_SelectionChanged" />
                <CheckBox x:Name="_mergePdfCheckBox" Content="合并 PDF" VerticalAlignment="Center"
                          Margin="12,0,12,0"
                          ToolTip="勾选后合并临时单页；可在批量打印设置中启用文件名书签或按纸张大小分别合并。" />
                <CheckBox x:Name="_leaveMarginCheckBox" Content="周边留白" VerticalAlignment="Center"
                          Margin="12,0,12,0" Checked="LeaveMargin_CheckedChanged" Unchecked="LeaveMargin_CheckedChanged"
                          ToolTip="勾选后按设定距离留白。正数=扩大纸张（比例不变）；负数=缩小比例。" />
                <ComboBox x:Name="_marginInput" Width="68" IsEditable="False"
                          VerticalContentAlignment="Center" Margin="0,0,2,0"
                          SelectionChanged="MarginInput_SelectionChanged" />
                <TextBlock Text="mm" VerticalAlignment="Center" Margin="3,0,8,0" />
            </StackPanel>
        </StackPanel>

        <!-- 作业清单（原 DataGridView） -->
        <DataGrid x:Name="_grid" Style="{StaticResource PluginGridStyle}"
                  Margin="0" AlternationCount="100000"
                  BeginningEdit="Grid_BeginningEdit"
                  CellEditEnding="Grid_CellEditEnding"
                  MouseDoubleClick="Grid_MouseDoubleClick"
                  PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                  PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                  SelectionChanged="Grid_SelectionChanged"
                  ContextMenuOpening="Grid_ContextMenuOpening">
            <DataGrid.Columns>
                <!-- 编号列：无绑定，由 RowIndexConverter 依据行号显示 -->
                <DataGridTemplateColumn Header="编号" Width="52" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex, Converter={StaticResource RowIndexConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="预览" Width="64" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="预览" Padding="6,0" MinHeight="20"
                                    Click="PreviewButton_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="_printColumn" Header="打印" Width="58">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                      Click="PrintCheck_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="_outputNameColumn" Header="PDF文件名"
                                    Binding="{Binding DisplayOutputFileName}" Width="220" IsReadOnly="True" />
                <DataGridTextColumn x:Name="_drawingNumberColumn" Header="图号" Width="160"
                                    Binding="{Binding DrawingNumber, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTipService.ToolTip="双击修改图号；对应 DWG 已打开时同步反写 CAD。">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Foreground"
                                    Value="{Binding DrawingNumber, Converter={StaticResource DuplicateBrushConverter}, ConverterParameter=DrawingNumber}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="_titleColumn" Header="图名" Width="240"
                                    Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTipService.ToolTip="双击修改图名；对应 DWG 已打开时同步反写 CAD。">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Foreground"
                                    Value="{Binding Title, Converter={StaticResource DuplicateBrushConverter}, ConverterParameter=Title}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="图幅" Binding="{Binding PaperName}" Width="82" IsReadOnly="True" />
                <DataGridTextColumn Header="比例" Binding="{Binding ScaleText}" Width="82" IsReadOnly="True" />
                <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="版次" Binding="{Binding Revision}" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="设计阶段" Binding="{Binding Phase}" Width="90" IsReadOnly="True" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="_moveToFirstItem" Header="移到第一个" Click="MoveToFirst_Click" />
                    <MenuItem x:Name="_markNotPrintItem" Header="不打印" Click="MarkNotPrint_Click" />
                    <MenuItem x:Name="_deleteItem" Header="删除" Click="DeleteHighlighted_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</Window>
