<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.15.6.4</Version>
    <AssemblyVersion>1.15.6.4</AssemblyVersion>
    <FileVersion>1.15.6.4</FileVersion>
    <InformationalVersion>1.15.6.4</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>AcadBatchPlot.Core</AssemblyName>
    <RootNamespace>ZwcadBatchPlot</RootNamespace>
    <DefineConstants>$(DefineConstants);AUTOCAD;ACAD_CORE</DefineConstants>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(RepoRoot)bin-acad2025-2027\</OutputPath>
  </PropertyGroup>

  <!-- 公共源码含平台条件编译（#if ZWCAD / #if AUTOCAD / #if ACAD_CORE），必须与平台实现
       一起按各自的编译常量编译并内联进单个 DLL，以便 CAD 通过 NETLOAD 加载单个文件。 -->
  <ItemGroup>
    <Compile Include="..\Common\**\*.cs" />
    <Compile Include="..\AutoCAD\**\*.cs" />
    <Page Include="..\Common\**\*.xaml">
      <Link>Common\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <EmbeddedResource Include="..\AutoCAD\**\*.resx" />

    <ProjectReference Include="..\PianNoCN\PianNoCN.csproj" />
    <None Remove="..\Common\**\*" />
    <None Remove="..\AutoCAD\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)resources\acad\Plotters\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Plotters\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="AutoCAD.NET.Core" Version="25.0.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>
</Project>
